# Three-mode testing system
# Mode 1: Record everything (AI calls + test outputs) - use for initial fixture creation
# TEST_MODE=record_all

# Mode 2: Use AI fixtures, record test outputs - use for test/code fixes after AI fixtures exist  
# TEST_MODE=verify_ai_record_tests

# Mode 3: Validate against all fixtures - use for CI/CD and normal development
TEST_MODE=verify_all

# Test OpenAI configuration - use real key for authentic testing
OPENAI_API_KEY=sk-proj-
TEST_INTERPRETER_MODEL=gpt-4o-mini
TEST_ARCHITECT_MODEL=gpt-4o-mini