# AI Financial Planning System - Environment Variables

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql://admin:admin123@postgres:5432/financial_planning

# Redis Configuration  
REDIS_URL=redis://redis:6379

# MinIO Configuration
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET_NAME=financial-data

# LangFuse Configuration
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890abcdef
LANGFUSE_SECRET_KEY=sk-lf-1234567890abcdef

# Application Configuration
APP_NAME=AI Financial Planning System
DEBUG=false
LOG_LEVEL=INFO

# Chainlit Configuration
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000